# Datos reales y generados: nunca al repositorio (los regenera la tubería en el servidor)
data/
historia/
capturas/
# …salvo la herramienta de fotos de la migración (código, sin fotos: las fotos van a ~/RO_MIGRACION)
!v2/tools/capturas/
*.db
*.db-journal
*.db-wal
*.db-shm
**/_privado/
**/_cache/
**/_crudo/
despliegue/estado/
fuentes*/_cache*/
*.antes*
__pycache__/
*.pyc
.DS_Store
.env
.env.*

# Configuración que vive en data/ pero no es dato de cliente
!data/
data/*
!data/mi_dia/
data/mi_dia/*
!data/mi_dia/config.json
!data/departamentos.json
!data/envios/
data/envios/*
!data/envios/interruptor.json

# Ficheros con datos reales que viven fuera de data/ (3-oct, revisión antes de subir a GitHub)
fuentes_gbp/*.json
despliegue/lista_access.txt
# Llaves y secretos: nunca al repositorio (viven en el llavero del Mac o en los secretos del servidor)
*.pem
*.key
*.p12
**/llavero*
**/secretos*
!escaner_secretos.py

# Migración: notas y plan de vuelta de cada noche, solo en el Mac (PLAN_NOCHE.md sí va al repositorio)
migracion/PLAN_VUELTA.md
migracion/NOTAS_NOCHE.md

# Dinero por cliente y rastro de operaciones: nunca a GitHub (3-oct)
fuentes_dinero/cuotas.json
fuentes_dinero/impagos_estado.json
fuentes_incidencias/rastro_operaciones.json

# Contextos SEO por cliente: registro privado
fuentes_seo/contextos_confirmados.json

# Objetivos históricos por cliente: pendientes de contraste, privados
fuentes_seo/objetivos_candidatos.json

# Registros operativos y vínculos del histórico: privados, separados del código
fuentes_metodo/reglas_operativas.json
fuentes_metodo/evidencias_reuniones.json
fuentes_verdad/servicios_confirmados.json
fuentes_verdad/objetivos_clientes.json
fuentes_historial_reuniones/*.json

# L-16: fuentes privadas locales; no incluir en Git
fuentes_dinero/*.json
**/_log_*.txt
**/_cache_*.json
fuentes/_muestras/
fuentes_captacion/anuncios.json
fuentes_consejos/cerebros/indice.json
