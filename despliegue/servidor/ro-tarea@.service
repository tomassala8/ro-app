# /etc/systemd/system/ro-tarea@.service · una vuelta de la tubería en el servidor propio (alternativa a Render). C5.
# %i = ligera | completa | noche. La lanza su .timer; nunca dos a la vez (bloqueo en la base y Type=oneshot).
[Unit]
Description=App RO · tubería (%i)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ro
WorkingDirectory=/srv/ro/ro-app
ExecStart=/usr/bin/docker compose --profile tareas run --rm tarea %i
TimeoutStartSec=3h
Nice=5
